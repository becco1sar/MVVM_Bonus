<UserControl x:Class="MVVM_Bonus.View.GeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:util="clr-namespace:MVVM_Bonus.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <util:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Style="{StaticResource AppBar}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource BrandAccent}" Margin="0,0,11,0"/>
                    <TextBlock Style="{StaticResource TextPageTitle}" Text="My team"/>
                </StackPanel>

                <!-- Docked right-to-left in the order written. -->
                <Button DockPanel.Dock="Right"
                        Content="Sign out"
                        Tag="{StaticResource IconLogout}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding SignOutCommand}"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        ToolTip="End your session on this computer"/>

                <!-- These machines are shared, so who is signed in must be visible. -->
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Style="{StaticResource TextCaption}" Text="Signed in as"/>
                    <TextBlock Style="{StaticResource TextBodyStrong}"
                               Text="{Binding TeamLeaderName}"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <TextBox DockPanel.Dock="Right"
                         Style="{StaticResource SearchBox}"
                         Tag="Search your team"
                         Width="260"
                         VerticalAlignment="Center"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="1" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <!-- The list is what the user acts on, so it leads; the detail panel
                     follows on the right. The old screen put the detail first, which
                     meant reading a result before choosing its input. -->
                <ColumnDefinition Width="2*" MinWidth="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Employee list -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextSectionTitle}" Text="Team members"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="8,3">
                                <TextBlock Style="{StaticResource BadgeText}"
                                           Foreground="{StaticResource TextSecondary}"
                                           Text="{Binding FilteredListPerson.Count}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredListPerson}"
                             SelectedItem="{Binding SelectedWorker}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             Padding="14,14,14,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBodyStrong}"
                                               Text="{Binding Name}"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Role}"/>
                                        <TextBlock Style="{StaticResource TextCaption}"
                                                   Text=" · "
                                                   Visibility="{Binding Contract, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Contract}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Loading. A blank panel with no explanation reads as a broken screen. -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="150" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource TextCaption}" Text="Loading your team…" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Empty: nobody assigned. -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="34"
                                Visibility="{Binding HasNoWorkers, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconUsers}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="No team members" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="270" TextAlignment="Center"
                                   Text="Nobody is assigned to you as an active employee. Ask HR to check the staff directory."/>
                    </StackPanel>

                    <!-- Empty: search matched nothing. A different problem, so different wording. -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="34"
                                Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconSearch}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="No matches" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="270" TextAlignment="Center"
                                   Text="{Binding Search, StringFormat='Nobody in your team matches “{0}”.'}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Selected employee -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <!-- Nothing selected. Four blank fields read as a failed load, so the
                         panel says what to do instead of showing empty labels. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconUser}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="Select an employee" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="300" TextAlignment="Center"
                                   Text="Pick someone from your team to see their details, review past bonuses, or record a new one."/>
                    </StackPanel>

                    <!-- Details -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Identity -->
                        <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{StaticResource BrandPrimary}"
                                        Margin="0,0,14,0">
                                    <Path Data="{StaticResource IconUser}"
                                          Style="{StaticResource IconPath}"
                                          Stroke="{StaticResource TextPrimary}"
                                          Width="21" Height="21"
                                          HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TextPageTitle}"
                                               Text="{Binding SelectedWorker.Name}" FontSize="17"/>
                                    <TextBlock Style="{StaticResource TextCaption}"
                                               Text="{Binding SelectedWorker.Role}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,20,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextOverline}" Text="Employee details" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource FieldTile}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TextCaption}" Text="Function"/>
                                            <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="14"
                                                       Text="{Binding SelectedWorker.Role}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource FieldTile}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TextCaption}" Text="Contract"/>
                                            <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="14"
                                                       Text="{Binding SelectedWorker.Contract}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Real values, queried per selection. This tile used to
                                         print a hardcoded "00/00/00". -->
                                    <Border Grid.Column="0" Style="{StaticResource FieldTile}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TextCaption}" Text="Last bonus period"/>
                                            <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="14"
                                                       Text="{Binding LastBonusPeriod}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource FieldTile}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TextCaption}" Text="Bonuses on record"/>
                                            <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="14"
                                                       Text="{Binding BonusCount}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource TextCaption}"
                                           Text="Looking up bonus history…"
                                           Margin="2,2,0,0"
                                           Visibility="{Binding IsSummaryLoading, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions. One primary; history is supporting. -->
                        <Border Grid.Row="2" Style="{StaticResource AppFooter}" Background="Transparent" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="View history"
                                        Tag="{StaticResource IconChart}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding GetPersonsBonus}"
                                        MinHeight="42"/>

                                <Button Grid.Column="2"
                                        Content="New bonus"
                                        Tag="{StaticResource IconPlus}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding InsertPersonsBonus}"
                                        MinHeight="42"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Footer ============ -->
        <Border Grid.Row="2" Style="{StaticResource AppFooter}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextCaption}"
                           Text="Bauer Media Outdoor · Quality Bonus v2.0"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}"
                           Text="{Binding ListPersons.Count, StringFormat='{}{0} active employees'}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
