<UserControl x:Class="MVVM_Bonus.View.GetBonusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MVVM_Bonus.View"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="1400">

	<UserControl.Resources>
		<Style x:Key="CardBorder" TargetType="Border">
			<Setter Property="Background" Value="#2A1D42"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#3D2B5C"/>
		</Style>
		
		<LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#6B3FA0" Offset="0.0" />
			<GradientStop Color="#4A2D7A" Offset="1.0" />
		</LinearGradientBrush>

		<LinearGradientBrush x:Key="TurquoiseGradient" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#00D4AA" Offset="0.0" />
			<GradientStop Color="#00B8A9" Offset="1.0" />
		</LinearGradientBrush>
	</UserControl.Resources>

	<Grid Background="#1A1225">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="0" x:Name="DetailPanelColumn"/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header Section -->
		<Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#221738"
                Padding="20"
                BorderThickness="0,0,0,1"
                BorderBrush="#3D2B5C">
			<DockPanel LastChildFill="False">
				<Button Content="⬅ Back"
                        Style="{StaticResource TransformedButtonBorder}"
                        Command="{Binding BackButtonCommand}"
                        DockPanel.Dock="Left"
                        Padding="15,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="{StaticResource PurpleGradient}"
                        BorderBrush="Transparent"
                        Margin="0,0,15,0"/>

				<TextBlock Text="{Binding SelectedBonusModel.WorkerName}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Margin="0,0,20,0"/>

				<Border DockPanel.Dock="Right"
                        CornerRadius="8"
                        Background="#1A1225"
                        BorderThickness="1"
                        BorderBrush="#3D2B5C"
                        Padding="10">
					<DockPanel LastChildFill="True">
						<TextBlock Text="🔍"
                                   Foreground="#B8A9D4"
                                   DockPanel.Dock="Left"
                                   FontSize="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
						<TextBox Background="Transparent"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="White"
                                 Padding="5"/>
					</DockPanel>
				</Border>
			</DockPanel>
		</Border>

		<!-- Main List Content Area -->
		<Border Grid.Row="1" Grid.Column="0" Margin="20">
			<Border Style="{StaticResource CardBorder}" Padding="0">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
                            Background="#221738"
                            CornerRadius="12,12,0,0"
                            Padding="20,15"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#3D2B5C">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="Bonus History"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"/>
							<TextBlock Text="{Binding FilteredListBonusModels.Count, StringFormat=' ({0})'}"
                                       Foreground="#8B7AAF"
                                       FontSize="13"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<ListBox x:Name="MyListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ItemsSource="{Binding FilteredListBonusModels}"
                                 SelectedItem="{Binding SelectedBonusModel, UpdateSourceTrigger=PropertyChanged}"
                                 IsTextSearchEnabled="True"
                                 Padding="15">
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListBoxItem">
												<Border x:Name="Bd"
                                                        CornerRadius="12"
                                                        Background="#221738"
                                                        Padding="15"
                                                        Margin="0,0,0,10"
                                                        BorderThickness="1"
                                                        BorderBrush="#3D2B5C"
                                                        Cursor="Hand">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>

														<StackPanel Grid.Column="0" VerticalAlignment="Center">
															<TextBlock Text="{Binding Period}"
                                                                       FontWeight="Bold"
                                                                       FontSize="14"
                                                                       Foreground="#00B8A9"
                                                                       Margin="0,0,0,4"/>
															<TextBlock Text="{Binding Total}"
                                                                       FontSize="12"
                                                                       Foreground="#B8A9D4"
                                                                       Opacity="0.8"/>
														</StackPanel>

														<TextBlock Grid.Column="1"
                                                                   Text="→"
                                                                   Foreground="#00B8A9"
                                                                   FontSize="16"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"
                                                                   FontWeight="Bold"/>
													</Grid>
												</Border>

												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="Bd" Property="Background" Value="#2A1D42"/>
														<Setter TargetName="Bd" Property="BorderBrush" Value="#00D4AA"/>
													</Trigger>
													<Trigger Property="IsSelected" Value="True">
														<Setter TargetName="Bd" Property="Background" Value="#3D2B5C"/>
														<Setter TargetName="Bd" Property="BorderBrush" Value="#00B8A9"/>
														<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ListBox.ItemContainerStyle>

							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</ScrollViewer>
				</Grid>
			</Border>
		</Border>

		<!-- Detail Panel -->
		<Border x:Name="DetailPanel"
                Grid.Row="1"
                Grid.Column="1"
                Width="Auto"
                Opacity="0"
                Background="#1A1225"
                BorderThickness="1,0,0,0"
                BorderBrush="#3D2B5C">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0"
                        Background="#221738"
                        Padding="15"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#3D2B5C">
					<DockPanel LastChildFill="False">
						<TextBlock Text="Bonus Details and Print Preview"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>
						<Button Content="✕"
                                DockPanel.Dock="Right"
                                Background="Transparent"
                                Foreground="#B8A9D4"
                                BorderThickness="0"
                                FontSize="16"
                                Cursor="Hand"
                                Click="CloseDetailPanel"
                                Padding="5"/>
					</DockPanel>
				</Border>

				<!-- New document preview -->
				<Grid Grid.Row="1" Margin="10">
					<FlowDocumentPageViewer Document="{Binding PreviewDocument}"
                                            Zoom="100"/>
				</Grid>

				<Border Grid.Row="2"
                        Background="#221738"
                        Padding="12"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#3D2B5C">
					<StackPanel Orientation="Horizontal" Margin="0">
						<Button Content="📄 Print"
                                Style="{StaticResource TransformedButtonBorder}"
                                Command="{Binding BtnPrintCommand}"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Background="{StaticResource TurquoiseGradient}"
                                BorderBrush="Transparent"
                                Width="120"
                                Margin="0,0,10,0"/>

						<Button Content="🔄 Refresh Preview"
                                Style="{StaticResource TransformedButtonBorder}"
                                Command="{Binding BtnPrintPreviewCommand}"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Background="{StaticResource PurpleGradient}"
                                BorderBrush="Transparent"
                                Width="150"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#221738"
                Padding="15"
                BorderThickness="0,1,0,0"
                BorderBrush="#3D2B5C">
			<TextBlock Text="💡 Tip: Click on any bonus card to view details and print preview"
                       Foreground="#8B7AAF"
                       FontSize="11"
                       FontStyle="Italic"/>
		</Border>
	</Grid>
</UserControl>