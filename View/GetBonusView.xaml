<UserControl x:Class="MVVM_Bonus.View.GetBonusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVM_Bonus.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Column="0" Grid.ColumnSpan="2">
      
            <Button Content="⬅" Style="{StaticResource TransformedButtonBorder}"  Command="{Binding BackButtonCommand}" />


            <TextBlock Text="{Binding SelectedBonusModel.WorkerName}" Foreground="white" FontSize="18" Margin="5" VerticalAlignment="Center"/>
            <!--<Button DockPanel.Dock="Right" Content="All" Background="Transparent" Foreground="White" BorderThickness="0" Command="{Binding ShowAllButtonCommand}"/>-->
            <Border DockPanel.Dock="Right" CornerRadius="15" BorderThickness="2" Background="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Foreground="Salmon" Background="Transparent" FontSize="18" Margin="5"  Width="200" BorderThickness="0"/>
            </Border>
            <TextBlock DockPanel.Dock="Right" Text="🔍 " Foreground="white" FontSize="18" Margin="5" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Right"/>

        </DockPanel>

     
        <Button Content="Preview" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Style="{StaticResource TransformedButtonBorder}" Command="{Binding BtnPrintCommand}"  />


        <ListBox Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding FilteredListBonusModels}" SelectedItem="{Binding SelectedBonusModel, UpdateSourceTrigger=PropertyChanged}" IsTextSearchEnabled="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="99">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border BorderThickness="0,0,0,1" BorderBrush="White">
                            <DockPanel>
                                <TextBlock Text="{Binding Period}" DockPanel.Dock="Top" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="White"/>
                                <TextBlock Text="{Binding Total}" FontSize="15" HorizontalAlignment="Center" Foreground="White"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>
</UserControl>
