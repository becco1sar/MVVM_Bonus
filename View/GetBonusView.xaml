<UserControl x:Class="MVVM_Bonus.View.GetBonusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:util="clr-namespace:MVVM_Bonus.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <util:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Style="{StaticResource AppBar}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="My team"
                        Tag="{StaticResource IconArrowLeft}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackButtonCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"/>

                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextPageTitle}" Text="{Binding CurrentPerson.Name}"/>
                    <TextBlock Style="{StaticResource TextCaption}" Text="Bonus history" Margin="0,1,0,0"/>
                </StackPanel>

                <TextBox DockPanel.Dock="Right"
                         Style="{StaticResource SearchBox}"
                         Tag="Filter by period, e.g. 3/2026"
                         Width="240"
                         VerticalAlignment="Center"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="330"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== History list ===== -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextSectionTitle}"
                                       Text="Recorded bonuses"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="8,3">
                                <TextBlock Style="{StaticResource BadgeText}"
                                           Foreground="{StaticResource TextSecondary}"
                                           Text="{Binding FilteredListBonusModels.Count}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- The list content lives in the item template, where it belongs.
                         It used to sit inside the container style with an empty
                         <Grid/> as the item template. -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredListBonusModels}"
                             SelectedItem="{Binding SelectedBonusModel}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             Padding="14,14,14,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Period"/>
                                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                                   Text="{Binding Period}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="Total" TextAlignment="Right"/>
                                        <TextBlock Style="{StaticResource TextAmount}" FontSize="16"
                                                   Foreground="{StaticResource BrandAccent}"
                                                   Text="{Binding Total, StringFormat='{}{0:N2} €'}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="34"
                                Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconInbox}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="No bonuses yet" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="260" TextAlignment="Center"
                                   Text="Nothing has been recorded for this employee. Go back and start a new bonus."/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="34"
                                Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconSearch}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="No matches" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="260" TextAlignment="Center"
                                   Text="{Binding Search, StringFormat='No period matches “{0}”.'}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Detail and print ===== -->
            <Border Grid.Column="1"
                    Width="620"
                    Background="{StaticResource BgSidebar}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{StaticResource BorderSubtle}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}" CornerRadius="0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Style="{StaticResource TextSectionTitle}" Text="Bonus sheet"/>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0"
                                           Text="{Binding SelectedBonusModel.Period, StringFormat='Period {0}'}"/>
                            </StackPanel>

                            <Button DockPanel.Dock="Right"
                                    Tag="{StaticResource IconClose}"
                                    Style="{StaticResource IconOnlyButton}"
                                    Command="{Binding BtnCloseDetailPanelCommand}"
                                    ToolTip="Close"/>
                        </DockPanel>
                    </Border>

                    <!-- Point wording could not be read: say so rather than showing
                         rows whose descriptions are silently blank. -->
                    <Border Grid.Row="1"
                            Style="{StaticResource StatusBanner}"
                            Background="{StaticResource WarningSoft}"
                            BorderBrush="{StaticResource WarningBrush}"
                            Margin="14,14,14,0"
                            Visibility="{Binding HasDetailWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TextBody}" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{Binding DetailWarning}"/>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource BgDarkest}" Padding="10" Margin="0,10,0,0">
                        <FlowDocumentPageViewer Document="{Binding PreviewDocument}" Zoom="90"/>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource AppFooter}">
                        <DockPanel LastChildFill="False">
                            <!-- One action. The neighbouring "Refresh Preview" button was
                                 bound to a command whose body was commented out, so it
                                 did nothing at all. -->
                            <Button DockPanel.Dock="Left"
                                    Content="Print this sheet"
                                    Tag="{StaticResource IconPrint}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BtnPrintCommand}"
                                    MinHeight="42" MinWidth="180"/>

                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextCaption}" Text="Total" TextAlignment="Right"/>
                                <TextBlock Style="{StaticResource TextAmount}" FontSize="19"
                                           Foreground="{StaticResource BrandAccent}"
                                           Text="{Binding SelectedBonusModel.Total, StringFormat='{}{0:N2} €'}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
