<UserControl x:Class="MVVM_Bonus.View.StaffManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:util="clr-namespace:MVVM_Bonus.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <util:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Style="{StaticResource AppBar}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Dashboard"
                        Tag="{StaticResource IconArrowLeft}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextPageTitle}"
                           Text="Staff directory" VerticalAlignment="Center"/>

                <Button DockPanel.Dock="Right"
                        Content="New employee"
                        Tag="{StaticResource IconPlus}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding NewEmployeeCommand}"
                        VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="340"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Directory ============ -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextSectionTitle}"
                                       Text="Employees"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="8,3">
                                <TextBlock Style="{StaticResource BadgeText}"
                                           Foreground="{StaticResource TextSecondary}"
                                           Text="{Binding FilteredWorkers.Count}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- The directory holds every employee ever recorded; without a
                         search this list was unusable past a couple of dozen people. -->
                    <TextBox Grid.Row="1"
                             Style="{StaticResource SearchBox}"
                             Tag="Search by name, role or team leader"
                             Margin="14,14,14,4"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredWorkers}"
                             SelectedItem="{Binding SelectedWorker}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             Padding="14,10,14,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="14"
                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Role}"/>
                                            <TextBlock Style="{StaticResource TextCaption}" Text=" · "
                                                       Visibility="{Binding TeamleaderName, Converter={StaticResource NullToVis}}"/>
                                            <TextBlock Style="{StaticResource TextCaption}" Text="{Binding TeamleaderName}"/>
                                        </StackPanel>

                                        <!-- Records the old insert produced: no team leader,
                                             so invisible to everyone who needs them. -->
                                        <TextBlock Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="No team leader assigned"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding IsUnassigned, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Padding="8,3"
                                            VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                <Setter Property="Background" Value="{StaticResource BgDarkest}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10"
                                                   Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrandAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="34"
                                Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconSearch}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="No matches" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="260" TextAlignment="Center"
                                   Text="{Binding Search, StringFormat='No employee matches “{0}”.'}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Editor ============ -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconUser}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="Select an employee" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="300" TextAlignment="Center"
                                   Text="Pick someone from the directory to edit their details, or add a new employee."/>
                    </StackPanel>

                    <Grid Visibility="{Binding HasEditor, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextSectionTitle}"
                                           Text="{Binding EditorTitle}"/>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                        Background="{StaticResource BrandPrimary}" Padding="9,4"
                                        Visibility="{Binding IsNewEmployee, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource BadgeText}" FontSize="10" Text="Not saved yet"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
                            <StackPanel MaxWidth="460" HorizontalAlignment="Left">

                                <TextBlock Style="{StaticResource TextFieldLabel}" Text="Full name"/>
                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15" MinHeight="40" Margin="0,0,0,16"/>

                                <!-- Required. An employee with no team leader is invisible to
                                     everyone who could record a bonus for them, which is what
                                     the old "Add as New" silently produced. -->
                                <TextBlock Style="{StaticResource TextFieldLabel}" Text="Team leader"/>
                                <ComboBox ItemsSource="{Binding TeamLeaders}"
                                          SelectedItem="{Binding EditTeamLeader}"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource TextCaption}"
                                           Text="Decides whose list this employee appears in."
                                           Margin="2,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource TextFieldLabel}" Text="Role / function"/>
                                        <TextBox Text="{Binding EditRole, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="38"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource TextFieldLabel}" Text="Language"/>
                                        <TextBox Text="{Binding EditLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="38"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource TextCaption}"
                                           Text="Role and language together decide which evaluation points this employee is scored on."
                                           TextWrapping="Wrap" Margin="2,0,0,20"/>

                                <Border Style="{StaticResource FieldTile}" Padding="14,12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding EditActive}" Content="Currently employed"/>
                                        <TextBlock Style="{StaticResource TextCaption}"
                                                   Text="Only active employees appear in team leaders' lists and in HR's completion figures."
                                                   TextWrapping="Wrap" Margin="28,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Style="{StaticResource AppFooter}" Background="Transparent">
                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Left"
                                        Content="{Binding SaveButtonText}"
                                        Tag="{StaticResource IconSave}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCommand}"
                                        MinHeight="42" MinWidth="170"/>

                                <Button DockPanel.Dock="Left"
                                        Content="Cancel"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding CancelCommand}"
                                        Margin="10,0,0,0"/>

                                <Border DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="360"
                                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ErrorSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource TextBody}" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"
                                               Text="{Binding StatusMessage}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
