<UserControl x:Class="MVVM_Bonus.View.HrDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:util="clr-namespace:MVVM_Bonus.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <util:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Style="{StaticResource AppBar}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource BrandAccent}" Margin="0,0,11,0"/>
                    <TextBlock Style="{StaticResource TextPageTitle}" Text="HR dashboard"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Sign out"
                        Tag="{StaticResource IconLogout}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding LogoutCommand}"
                        VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Loading is a thin bar under the app bar rather than a frozen window. -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="2" Margin="20,18,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Left: period, export, administration ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Reporting. Period and export belong together: one is the input
                         to the other. The old panel numbered them 1-2-3 alongside staff
                         administration, implying a sequence that does not exist. -->
                    <Border Style="{StaticResource Panel}" Padding="20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextOverline}" Text="Reporting" Margin="0,0,0,14"/>

                            <TextBlock Style="{StaticResource TextFieldLabel}" Text="Bonus period"/>
                            <ComboBox ItemsSource="{Binding AvailablePeriods}"
                                      SelectedItem="{Binding SelectedPeriod}"
                                      IsEnabled="{Binding IsNotLoading}"
                                      Margin="0,0,0,18"/>

                            <Button Content="Export to Excel"
                                    Tag="{StaticResource IconDownload}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ExportExcelCommand}"
                                    MinHeight="42"
                                    Margin="0,0,0,8"/>

                            <Button Content="Refresh figures"
                                    Tag="{StaticResource IconRefresh}"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding RefreshCommand}"/>

                            <!-- Status. Success and failure now look different. -->
                            <Border Margin="0,16,0,0"
                                    Visibility="{Binding ExportStatus, Converter={StaticResource NullToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ErrorSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource TextBody}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="12"
                                           Text="{Binding ExportStatus}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Administration: separate task, separate panel. -->
                    <Border Style="{StaticResource Panel}" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextOverline}" Text="Administration" Margin="0,0,0,14"/>

                            <Button Content="Staff directory"
                                    Tag="{StaticResource IconUsers}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ManageStaffCommand}"
                                    HorizontalContentAlignment="Left"
                                    MinHeight="42"
                                    Margin="0,0,0,8"/>

                            <Button Content="Default bonus values"
                                    Tag="{StaticResource IconSettings}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ConfigBonusCommand}"
                                    HorizontalContentAlignment="Left"
                                    MinHeight="42"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Right: completion ============ -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextSectionTitle}"
                                       Text="Submission progress"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedPeriod, StringFormat='Period {0}'}"/>
                        </DockPanel>
                    </Border>

                    <!-- Roll-up. The headline number is the completion rate; the counts
                         behind it are secondary. -->
                    <Grid Grid.Row="1" Margin="20,20,20,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource FieldTile}" Padding="18,15" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Complete"/>
                                <TextBlock Style="{StaticResource TextMetric}"
                                           Foreground="{StaticResource BrandAccent}"
                                           Text="{Binding OverallPercentText}"
                                           Margin="0,4,0,8"/>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding OverallFraction, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource FieldTile}" Padding="18,15" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Bonuses submitted"/>
                                <TextBlock Style="{StaticResource TextMetric}" Margin="0,4,0,0">
                                    <Run Text="{Binding TotalBonusesFound, Mode=OneWay}"/>
                                    <Run Text="/" Foreground="{StaticResource TextMuted}" FontSize="20"/>
                                    <Run Text="{Binding TotalActiveWorkers, Mode=OneWay}"
                                         Foreground="{StaticResource TextMuted}" FontSize="20"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource FieldTile}" Padding="18,15" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextCaption}" Text="Team leaders outstanding"/>
                                <TextBlock Style="{StaticResource TextMetric}"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="{Binding PendingTeamLeaderCount}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Per-team-leader rows, least complete first. Rows stretch instead
                         of being pinned to Width="780", which clipped on smaller screens. -->
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding TeamLeaderStatuses}"
                              ItemContainerStyle="{StaticResource StaticListViewItem}"
                              Margin="20,10,20,16">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Style="{StaticResource TextBodyStrong}"
                                                   FontSize="14"
                                                   Text="{Binding TeamleaderName}"/>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextAmount}"
                                                       Text="{Binding StatusText}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <Border Padding="9,4">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                        <Setter Property="Background" Value="{StaticResource WarningSoft}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFullyCompleted}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ProgressPercentText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFullyCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                         Minimum="0" Maximum="1"
                                                         Value="{Binding ProgressFraction, Mode=OneWay}"
                                                         VerticalAlignment="Center">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFullyCompleted}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource TextCaption}"
                                                       Text="{Binding RemainingText}"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- No period chosen yet, or nothing to show for it. -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40"
                                Visibility="{Binding HasNoStatuses, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconInbox}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="Nothing to show" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="300" TextAlignment="Center"
                                   Text="Choose a bonus period on the left to see how far each team leader has got."/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
