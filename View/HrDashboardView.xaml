<UserControl x:Class="MVVM_Bonus.View.HrDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVM_Bonus.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#1A1225">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#221738" Padding="24,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#00B8A9" Margin="0,0,12,0"/>
                    <TextBlock Text="HR Admin Dashboard" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="Log Out" Style="{StaticResource TransformedButtonBorder}" Command="{Binding LogoutCommand}" Padding="15,8" FontSize="12">
                    <Button.Background>
                        <SolidColorBrush Color="#2A1D42"/>
                    </Button.Background>
                </Button>
            </DockPanel>
        </Border>

        <!-- Loading Overlay (Visible when IsLoading is true) -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4" VerticalAlignment="Top" 
                     Foreground="#00B8A9" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Period Selection & Export -->
            <Border Grid.Column="0" Background="#2A1D42" CornerRadius="14" Padding="25" VerticalAlignment="Stretch" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="1. SELECT PERIOD" Foreground="#00B8A9" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <ComboBox ItemsSource="{Binding AvailablePeriods}" SelectedItem="{Binding SelectedPeriod}" 
                              Margin="0,0,0,30" Padding="10" FontSize="16" Height="45" IsEnabled="{Binding IsNotLoading}"/>

                    <TextBlock Text="2. MANAGE SYSTEM" Foreground="#00B8A9" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Button Content="👥 Manage Staff Directory" Style="{StaticResource TransformedButtonBorder}" 
                            Command="{Binding ManageStaffCommand}" Padding="15" FontSize="14" FontWeight="Bold" Foreground="White"
                            Margin="0,0,0,10" Background="#221738"/>
                    <Button Content="⚙️ Configure Default Bonuses" Style="{StaticResource TransformedButtonBorder}" 
                            Command="{Binding ConfigBonusCommand}" Padding="15" FontSize="14" FontWeight="Bold" Foreground="White"
                            Margin="0,0,0,30" Background="#221738"/>

                    <TextBlock Text="3. EXPORT TO EXCEL" Foreground="#00B8A9" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <Button Content="📊 Download Excel File" Style="{StaticResource TransformedButtonBorder}" 
                            Command="{Binding ExportExcelCommand}" Padding="15" FontSize="14" FontWeight="Bold" Foreground="White"
                            IsEnabled="{Binding IsNotLoading}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00B8A9" Offset="0"/>
                                <GradientStop Color="#00D4AA" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <TextBlock Text="{Binding ExportStatus}" Foreground="#B8A9D4" FontSize="13" Margin="0,20,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- RIGHT PANEL: Completion Statistics -->
            <Border Grid.Column="1" Background="#2A1D42" CornerRadius="14" Padding="30" VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="TEAM LEADER COMPLETION STATUS" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Summary Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#221738" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Total Active Workers" Foreground="#8B7AAF" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalActiveWorkers}" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#221738" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Bonuses Submitted" Foreground="#8B7AAF" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TotalBonusesFound}" Foreground="#00B8A9" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Details List -->
                    <ListView Grid.Row="2" ItemsSource="{Binding TeamLeaderStatuses}" Background="Transparent" BorderThickness="0" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#221738" CornerRadius="8" Padding="20,15" Margin="0,0,0,10" Width="780">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding TeamleaderName}" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        
                                        <Border Grid.Column="1" Background="{Binding ProgressColor}" CornerRadius="6" Padding="15,8">
                                            <TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
