<UserControl x:Class="MVVM_Bonus.View.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:util="clr-namespace:MVVM_Bonus.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1100">

    <UserControl.Resources>
        <util:NullToVisibilityConverter x:Key="NullToVis"/>

        <Storyboard x:Key="OnLoadAnimation">
            <DoubleAnimation Storyboard.TargetName="LoginCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetName="LoginCardTransform"
                             Storyboard.TargetProperty="Y"
                             From="18" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource OnLoadAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="{StaticResource BgDarkestColor}" Offset="0"/>
                <GradientStop Color="{StaticResource BrandPrimaryDarkColor}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border x:Name="LoginCard"
                Style="{StaticResource Panel}"
                Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LoginCardTransform" Y="18"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="34" Opacity="0.45" Direction="270" ShadowDepth="8"/>
            </Border.Effect>

            <StackPanel Margin="34,38,34,34">

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrandAccent}"
                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="Bauer Media Outdoor"
                               Foreground="{StaticResource BrandAccent}"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Quality Bonus"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="Segoe UI" FontSize="27" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Style="{StaticResource TextBody}"
                           Text="Sign in with your team leader name."
                           TextAlignment="Center" Margin="0,0,0,30"/>

                <!-- Sign-in field -->
                <TextBlock Style="{StaticResource TextFieldLabel}" Text="Team leader"/>

                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="UserNameBox"
                             Padding="38,10,12,10"
                             MinHeight="44"
                             FontSize="15"
                             Text="{Binding TeamLeaderUserName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <!-- Enter submits: this field is the only thing on the screen. -->
                            <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Path Data="{StaticResource IconUser}"
                          Style="{StaticResource IconPath}"
                          Stroke="{StaticResource TextMuted}"
                          HorizontalAlignment="Left"
                          Margin="13,0,0,0"
                          IsHitTestVisible="False"/>
                </Grid>

                <!-- Inline failure text. A modal dialog for a misspelled name interrupts
                     more than it helps and covers the field that needs correcting. -->
                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}"
                        Background="{StaticResource ErrorSoft}"
                        BorderBrush="{StaticResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="11,9"
                        Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAlert}"
                              Style="{StaticResource IconPathSmall}"
                              Stroke="{StaticResource ErrorText}"
                              VerticalAlignment="Top"
                              Margin="0,2,9,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorText}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="17"
                                   MaxWidth="250"/>
                    </StackPanel>
                </Border>

                <Button Content="Sign in"
                        Style="{StaticResource PrimaryButton}"
                        Tag="{StaticResource IconLogout}"
                        Command="{Binding LoginCommand}"
                        MinHeight="46"
                        FontSize="14"
                        Margin="0,22,0,0"
                        IsDefault="True"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource TextCaption}"
                   Text="Quality Bonus v2.0"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Margin="0,0,0,22"/>
    </Grid>
</UserControl>
