<UserControl x:Class="MVVM_Bonus.View.InsertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MVVM_Bonus.View"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1400">

	<UserControl.Resources>
		<Style x:Key="CardBorder" TargetType="Border">
			<Setter Property="Background" Value="#2A1D42"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#3D2B5C"/>
		</Style>

        <Style TargetType="TextBox" x:Key="DarkTextBox">
            <Setter Property="Background" Value="#221738"/>
            <Setter Property="Foreground" Value="#B8A9D4"/>
            <Setter Property="BorderBrush" Value="#3D2B5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00B8A9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
	</UserControl.Resources>

	<Grid Background="#1A1225">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="0" x:Name="PreviewPanelColumn"/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#221738"
                Padding="20"
                BorderThickness="0,0,0,1"
                BorderBrush="#3D2B5C">
			<DockPanel LastChildFill="False">
				<Button Content="⬅ Back"
                        Style="{StaticResource TransformedButtonBorder}"
                        Command="{Binding BackButtonCommand}"
                        DockPanel.Dock="Left"
                        Padding="15,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,0,15,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A2D7A" Offset="0"/>
                            <GradientStop Color="#6B3FA0" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

				<TextBlock Text="{Binding Worker.Name}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

				<DatePicker HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            Margin="20,0,0,0"
                            SelectedDate="{Binding DatePickerText}"
                            Background="#221738" Foreground="#B8A9D4" BorderBrush="#3D2B5C"/>
			</DockPanel>
		</Border>

		<!-- Main content -->
		<Border Grid.Row="1" Grid.Column="0" Margin="20">
			<Border Style="{StaticResource CardBorder}" Padding="20">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
                               Text="Bonus Items"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

					<Border Grid.Row="1"
                            Background="#1A1225"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="#3D2B5C"
                            Padding="0">
						<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
							<ListBox Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding MyBonusValuePoints, NotifyOnSourceUpdated=True}"
                                     SelectedItem="{Binding SelectedBonusPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SelectionMode="Multiple"
                                     HorizontalContentAlignment="Stretch"
                                     Padding="10">
								<ListBox.ItemContainerStyle>
									<Style TargetType="{x:Type ListBoxItem}">
										<Setter Property="IsSelected" Value="{Binding Mode=TwoWay, Path=IsSelected}"/>
										<Setter Property="IsEnabled" Value="{Binding Mode=TwoWay, Path=IsEnabled}"/>
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Margin" Value="0,0,0,8"/>
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Cursor" Value="Hand"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</ListBox.ItemContainerStyle>

								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border x:Name="ItemCard"
                                                Background="#221738"
                                                CornerRadius="8"
                                                Padding="12"
                                                BorderThickness="1"
                                                BorderBrush="#3D2B5C">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="170"/>
													<ColumnDefinition Width="70"/>
												</Grid.ColumnDefinitions>

												<TextBlock Grid.Column="0"
                                                           Text="{Binding Item, UpdateSourceTrigger=PropertyChanged}"
                                                           FontSize="13"
                                                           Foreground="#B8A9D4"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,10,0"/>

												<TextBox Grid.Column="1"
                                                         Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="WrapWithOverflow"
                                                         AcceptsReturn="True"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Margin="10,0,10,0"
                                                         FontSize="12"/>

												<TextBlock Grid.Column="2"
                                                           Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="#00B8A9"/>
											</Grid>
										</Border>

										<DataTemplate.Triggers>
											<DataTrigger Binding="{Binding IsSelected}" Value="True">
												<Setter TargetName="ItemCard" Property="Background" Value="#2A1D42"/>
												<Setter TargetName="ItemCard" Property="BorderBrush" Value="#00B8A9"/>
												<Setter TargetName="ItemCard" Property="BorderThickness" Value="2"/>
												<Setter TargetName="ItemCard" Property="Effect">
													<Setter.Value>
														<DropShadowEffect Color="#00B8A9" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
													</Setter.Value>
												</Setter>
											</DataTrigger>

											<DataTrigger Binding="{Binding IsEnabled}" Value="False">
												<Setter TargetName="ItemCard" Property="Opacity" Value="0.4"/>
											</DataTrigger>
										</DataTemplate.Triggers>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</Border>

					<ItemsControl Grid.Row="2" ItemsSource="{Binding CustomBonusCategories}" Margin="0,15,0,0">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#221738"
										CornerRadius="8"
										Padding="12"
										Margin="0,0,0,8"
										BorderThickness="1"
										BorderBrush="#3D2B5C">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="170"/>
											<ColumnDefinition Width="80"/>
										</Grid.ColumnDefinitions>

										<TextBlock Grid.Column="0"
												   Text="{Binding CategoryName}"
												   Foreground="#00B8A9"
												   FontSize="13"
												   FontWeight="SemiBold"
												   VerticalAlignment="Center"/>

										<TextBox Grid.Column="1"
												 Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 TextWrapping="Wrap"
												 AcceptsReturn="True"
												 Style="{StaticResource DarkTextBox}"
												 Margin="10,0,10,0"
												 FontSize="12"/>

										<TextBox Grid.Column="2"
												 Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 Style="{StaticResource DarkTextBox}"
												 FontSize="14"
												 TextAlignment="Center"
												 FontWeight="Bold"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Border Grid.Row="3"
                            Background="#221738"
                            CornerRadius="6"
                            Padding="15"
                            Margin="0,20,0,0"
                            BorderThickness="2"
                            BorderBrush="#00B8A9">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0"
                                       Text="Total Amount"
                                       Foreground="#B8A9D4"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

							<TextBlock Grid.Column="1"
                                       Text="{Binding CurrentBonusAmount}"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Right"/>
						</Grid>
					</Border>
				</Grid>
			</Border>
		</Border>

		<!-- Preview sidebar -->
		<Border x:Name="PreviewPanel"
                Grid.Row="1"
                Grid.Column="1"
                Opacity="0"
                Background="#221738"
                BorderThickness="1,0,0,0"
                BorderBrush="#3D2B5C">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0"
                        Background="#1A1225"
                        Padding="15"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#3D2B5C">
					<DockPanel LastChildFill="False">
						<TextBlock Text="Generated Bonus File Preview"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>
						<Button Content="✕"
                                DockPanel.Dock="Right"
                                Background="Transparent"
                                Foreground="#8B7AAF"
                                BorderThickness="0"
                                FontSize="16"
                                Cursor="Hand"
                                Click="ClosePreviewPanel"
                                Padding="5"/>
					</DockPanel>
				</Border>

				<Grid Grid.Row="1" Margin="10">
					<FlowDocumentPageViewer Document="{Binding PreviewDocument}"
                                            Zoom="100"/>
				</Grid>

				<Border Grid.Row="2"
                        Background="#221738"
                        Padding="12"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#3D2B5C">
					<StackPanel Orientation="Horizontal">
						<Button Content="📄 Print"
                                Style="{StaticResource TransformedButtonBorder}"
                                Command="{Binding PrintButtonCommand}"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Width="120"
                                Margin="0,0,10,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00B8A9" Offset="0"/>
                                    <GradientStop Color="#00D4AA" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

						<Button Content="🔄 Refresh Preview"
                                Style="{StaticResource TransformedButtonBorder}"
                                Command="{Binding BtnPreviewCommand}"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Width="150"
                                Margin="0,0,10,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4A2D7A" Offset="0"/>
                                    <GradientStop Color="#6B3FA0" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

						<Button Content="✕ Close"
                                Style="{StaticResource TransformedButtonBorder}"
                                Command="{Binding ClosePreviewCommand}"
                                Padding="12,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Width="120">
                            <Button.Background>
                                <SolidColorBrush Color="#2A1D42"/>
                            </Button.Background>
                        </Button>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#221738"
                Padding="20"
                BorderThickness="0,1,0,0"
                BorderBrush="#3D2B5C">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
                        Content="✓ Finish and Preview"
                        Style="{StaticResource TransformedButtonBorder}"
                        Command="{Binding BtnCommandClicked}"
                        Padding="15,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,0,10,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00B8A9" Offset="0"/>
                            <GradientStop Color="#00D4AA" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

				<Button Grid.Column="1"
                        Content="⟲ Reset"
                        Style="{StaticResource TransformedButtonBorder}"
                        Command="{Binding BtnResetCommandClicked}"
                        Padding="15,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A2D7A" Offset="0"/>
                            <GradientStop Color="#6B3FA0" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
			</Grid>
		</Border>
	</Grid>
</UserControl>