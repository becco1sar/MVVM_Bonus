<UserControl x:Class="MVVM_Bonus.View.InsertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:util="clr-namespace:MVVM_Bonus.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <util:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- One evaluation point: an actual checkbox, the amount it is worth, and a
             comment box. Awarding a point used to mean selecting a row in a
             multi-select ListBox, with nothing on screen to suggest that clicking
             was how you awarded anything. -->
        <DataTemplate x:Key="BonusPointTemplate">
            <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BgSidebar}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandPrimaryDark}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled}"
                              VerticalAlignment="Top"
                              Margin="0,1,12,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource TextBody}"
                               Foreground="{StaticResource TextPrimary}"
                               Text="{Binding Item}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Style="{StaticResource TextAmount}"
                               Text="{Binding Amount, StringFormat='{}{0:N2} €'}"
                               VerticalAlignment="Center"
                               MinWidth="80"
                               Margin="14,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextAmount}">
                                <!-- Muted until awarded, so the running total is easy to
                                     trace back to the rows that produced it. -->
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrandAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEnabled}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="32"
                             FontSize="12"
                             Margin="0,10,0,0"
                             ToolTip="Optional note, printed on the sheet the employee signs"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Style="{StaticResource AppBar}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="My team"
                        Tag="{StaticResource IconArrowLeft}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackButtonCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"/>

                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextPageTitle}" Text="{Binding Worker.Name}"/>
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding Worker.Role}" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Month and year only: the record stores "M/yyyy", so the old date
                     picker asked for a day and then discarded it. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextCaption}" Text="Bonus period"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding Months}"
                              SelectedItem="{Binding SelectedMonth}"
                              DisplayMemberPath="Name"
                              Width="130" MinHeight="36" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding Years}"
                              SelectedItem="{Binding SelectedYear}"
                              Width="88" MinHeight="36" FontSize="13"
                              Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ---------- Form ---------- -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20,18,20,0">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                    <!-- Period clash, checked as soon as the period changes rather than
                         after the whole form has been filled in. -->
                    <Border Style="{StaticResource StatusBanner}"
                            Background="{StaticResource ErrorSoft}"
                            BorderBrush="{StaticResource ErrorBrush}"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasPeriodWarning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAlert}"
                                  Style="{StaticResource IconPathSmall}"
                                  Stroke="{StaticResource ErrorText}"
                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock Style="{StaticResource TextBody}"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="{Binding PeriodWarning}" MaxWidth="700"/>
                        </StackPanel>
                    </Border>

                    <!-- Profile has more points + categories than the ten stored columns. -->
                    <Border Style="{StaticResource StatusBanner}"
                            Background="{StaticResource WarningSoft}"
                            BorderBrush="{StaticResource WarningBrush}"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasCapacityWarning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAlert}"
                                  Style="{StaticResource IconPathSmall}"
                                  Stroke="{StaticResource WarningBrush}"
                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock Style="{StaticResource TextBody}"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="{Binding CapacityWarning}" MaxWidth="700"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Base points ===== -->
                    <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextOverline}" Text="Base points"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextAmount}"
                                           Text="{Binding BaseTotal, StringFormat='{}{0:N2} €'}"/>
                            </DockPanel>

                            <!-- The unlock rule made visible. It was enforced in code and
                                 explained nowhere: the extra points just sat greyed out. -->
                            <Grid Margin="0,10,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ProgressBar Grid.Row="0" Grid.Column="0"
                                             Minimum="0"
                                             Maximum="{Binding RequiredBase}"
                                             Value="{Binding AwardedBaseCount, Mode=OneWay}"
                                             Height="6"
                                             VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource TextCaption}"
                                           Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Run Text="{Binding AwardedBaseCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding RequiredBase, Mode=OneWay}"/>
                                </TextBlock>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Path Style="{StaticResource IconPathSmall}" VerticalAlignment="Top" Margin="0,2,8,0">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource IconPathSmall}">
                                                <Setter Property="Data" Value="{StaticResource IconLock}"/>
                                                <Setter Property="Stroke" Value="{StaticResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                                        <Setter Property="Stroke" Value="{StaticResource BrandAccent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding UnlockHint}" MaxWidth="640"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding BaseBonusPoints}"
                                          ItemTemplate="{StaticResource BonusPointTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Additional points ===== -->
                    <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,14"
                            Visibility="{Binding HasAdditionalPoints, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextOverline}" Text="Additional points"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextAmount}"
                                           Text="{Binding AdditionalTotal, StringFormat='{}{0:N2} €'}"/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,14"
                                       Text="Available only once all three base points are awarded."/>

                            <!-- Locked notice, so a greyed-out block is never unexplained. -->
                            <Border Style="{StaticResource FieldTile}" Padding="14,12" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FieldTile}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLock}"
                                          Style="{StaticResource IconPathSmall}"
                                          Stroke="{StaticResource TextMuted}"
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Style="{StaticResource TextBody}" VerticalAlignment="Center"
                                               Text="Locked. Award the three base points above first."/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding AdditionalBonusPoints}"
                                          ItemTemplate="{StaticResource BonusPointTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Extra amounts ===== -->
                    <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextOverline}" Text="Extra amounts"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextAmount}"
                                           Text="{Binding ExtrasTotal, StringFormat='{}{0:N2} €'}"/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,14"
                                       Text="Typed in directly, and not subject to the base point rule."/>

                            <ItemsControl ItemsSource="{Binding CustomBonusCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Style="{StaticResource TextBodyStrong}"
                                                           Text="{Binding CategoryName}"
                                                           VerticalAlignment="Center"/>

                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Style="{StaticResource AmountTextBox}"
                                                         Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                         Width="110" Margin="14,0,0,0"/>

                                                <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                                                         Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="32" FontSize="12" Margin="0,10,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ---------- Review panel ---------- -->
            <Border Grid.Column="1"
                    Width="620"
                    Background="{StaticResource BgSidebar}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{StaticResource BorderSubtle}"
                    Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}" CornerRadius="0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Style="{StaticResource TextSectionTitle}" Text="Bonus sheet"/>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                            <Setter Property="Text" Value="Not saved yet"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                    <Setter Property="Text" Value="Saved"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrandAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource BgDarkest}" Padding="10">
                        <FlowDocumentPageViewer Document="{Binding PreviewDocument}" Zoom="90"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Footer: total and the one next step ============ -->
        <Border Grid.Row="2" Style="{StaticResource AppFooter}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Total, with the breakdown that produced it. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextCaption}" Text="Total bonus"/>
                    <TextBlock Style="{StaticResource TextAmount}"
                               FontSize="26"
                               Foreground="{StaticResource BrandAccent}"
                               TextAlignment="Left"
                               Text="{Binding CurrentBonusAmount, StringFormat='{}{0:N2} €'}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,20,0">
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding AwardedCountText}"/>
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,3,0,0">
                        <Run Text="Base"/>
                        <Run Text="{Binding BaseTotal, Mode=OneWay, StringFormat='{}{0:N2} €'}" Foreground="{StaticResource TextSecondary}"/>
                        <Run Text="  ·  Additional"/>
                        <Run Text="{Binding AdditionalTotal, Mode=OneWay, StringFormat='{}{0:N2} €'}" Foreground="{StaticResource TextSecondary}"/>
                        <Run Text="  ·  Extra"/>
                        <Run Text="{Binding ExtrasTotal, Mode=OneWay, StringFormat='{}{0:N2} €'}" Foreground="{StaticResource TextSecondary}"/>
                    </TextBlock>

                    <Border Margin="0,8,0,0" HorizontalAlignment="Left" MaxWidth="520"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                                <Setter Property="Padding" Value="11,7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorSoft}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource TextBody}" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{Binding StatusMessage}"/>
                    </Border>
                </StackPanel>

                <!-- Actions, one stage at a time. Editing offers review, not save:
                     saving is a separate deliberate step after the sheet is checked. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <Button Content="Reset"
                                Tag="{StaticResource IconReset}"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding BtnResetCommandClicked}"
                                MinHeight="44" Margin="0,0,10,0"/>
                        <Button Content="Review sheet"
                                Tag="{StaticResource IconDocument}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ReviewCommand}"
                                MinHeight="44" MinWidth="180"
                                ToolTip="Builds the sheet for checking. Nothing is saved yet."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}">
                        <Button Content="Keep editing"
                                Tag="{StaticResource IconArrowLeft}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding EditAgainCommand}"
                                MinHeight="44" Margin="0,0,10,0"/>
                        <Button Content="Confirm and save"
                                Tag="{StaticResource IconCheck}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmSaveCommand}"
                                MinHeight="44" MinWidth="200"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}">
                        <Button Content="Print"
                                Tag="{StaticResource IconPrint}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding PrintButtonCommand}"
                                MinHeight="44" Margin="0,0,10,0"/>
                        <Button Content="Done"
                                Tag="{StaticResource IconCheck}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BackButtonCommand}"
                                MinHeight="44" MinWidth="150"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
