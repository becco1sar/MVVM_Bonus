<UserControl x:Class="MVVM_Bonus.View.BonusConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:util="clr-namespace:MVVM_Bonus.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <util:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Style="{StaticResource AppBar}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Dashboard"
                        Tag="{StaticResource IconArrowLeft}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextPageTitle}"
                           Text="Default bonus values" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Profiles ============ -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                        <TextBlock Style="{StaticResource TextSectionTitle}" Text="Profiles"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding BonusConfigs}"
                             SelectedItem="{Binding SelectedConfig}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             Padding="14,14,14,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="14"
                                               Text="{Binding DisplayName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <!-- Says who a profile affects. "Profile ID: 1" alone
                                             gave no clue what changing it would do. -->
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding UsageText}"/>
                                        <TextBlock Style="{StaticResource TextCaption}" Text=" · max "/>
                                        <TextBlock Style="{StaticResource TextCaption}"
                                                   Text="{Binding Total, StringFormat='{}{0:N2} €'}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                                Visibility="{Binding HasNoConfigs, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TextBody}" TextAlignment="Center"
                                   Text="No bonus profiles found in the database."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Editor ============ -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <!-- Nothing selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconSettings}"
                              Style="{StaticResource IconPathLarge}"
                              Stroke="{StaticResource TextMuted}"
                              HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Style="{StaticResource TextBodyStrong}" FontSize="15"
                                   Text="Select a profile" TextAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource TextBody}" MaxWidth="320" TextAlignment="Center"
                                   Text="Each profile sets the maximum amount payable for the ten evaluation points, for the employees assigned to it."/>
                    </StackPanel>

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Style="{StaticResource TextSectionTitle}"
                                               Text="{Binding SelectedConfig.DisplayName}"/>
                                    <TextBlock Style="{StaticResource TextCaption}"
                                               Text="{Binding SelectedConfig.UsageText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Maximum total"
                                               TextAlignment="Right"/>
                                    <TextBlock Style="{StaticResource TextAmount}" FontSize="20"
                                               Foreground="{StaticResource BrandAccent}"
                                               Text="{Binding EditTotal, StringFormat='{}{0:N2} €'}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
                            <StackPanel>

                                <!-- Grouped to match the rule the app already enforces:
                                     points 1-3 must all be awarded before 4-10 unlock. The
                                     old form was ten boxes labelled "Value A" to "Value J",
                                     which showed neither the order nor the rule. -->
                                <Border Style="{StaticResource FieldTile}" Padding="16,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextOverline}"
                                                       Text="Base points 1-3"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextAmount}"
                                                       Text="{Binding EditBaseTotal, StringFormat='{}{0:N2} €'}"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource TextCaption}"
                                                   Text="All three must be awarded before points 4-10 become available."
                                                   Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="1" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditA, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="2" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 2" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditB, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="3" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 3" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditC, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FieldTile}" Padding="16,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextOverline}"
                                                       Text="Additional points 4-10"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextAmount}"
                                                       Text="{Binding EditAdditionalTotal, StringFormat='{}{0:N2} €'}"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource TextCaption}"
                                                   Text="Unlocked only once all three base points are awarded."
                                                   Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="4" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 4" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditD, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="5" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 5" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditE, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="6" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 6" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditF, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="7" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 7" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditG, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="8" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 8" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditH, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="9" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 9" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditI, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                            Background="{StaticResource BgDarkest}"
                                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="10" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextBody}"
                                               Text="Evaluation point 10" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource AmountTextBox}"
                                             Text="{Binding EditJ, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Style="{StaticResource AppFooter}" Background="Transparent">
                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Left"
                                        Content="Save changes"
                                        Tag="{StaticResource IconSave}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCommand}"
                                        MinHeight="42" MinWidth="170"/>

                                <Button DockPanel.Dock="Left"
                                        Content="Revert"
                                        Tag="{StaticResource IconReset}"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding RevertCommand}"
                                        Margin="10,0,0,0"/>

                                <Border DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="380"
                                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBanner}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ErrorSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource TextBody}" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"
                                               Text="{Binding StatusMessage}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
