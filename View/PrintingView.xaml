<UserControl x:Class="MVVM_Bonus.View.PrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVM_Bonus.View"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1000">

    <Grid Background="#1A1225">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#221738" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="#3D2B5C">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#00B8A9" Margin="0,0,12,0"/>
                <TextBlock Text="Print Preview" Foreground="White" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Print Area (kept white for actual printing) -->
        <ScrollViewer Grid.Row="1" Margin="20" Background="#2A1D42" 
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Name="PrintArea" Background="White" HorizontalAlignment="Center" 
                  MaxHeight="27.5cm" MaxWidth="21cm" Margin="20">
                <Grid.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Grid.Effect>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.35*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="0.75*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Bauer Media Outdoor" FontSize="20" Padding="15,10,0,0"/>

                <ListView Margin="10" AlternationCount="2" Grid.Row="1" Grid.ColumnSpan="3" 
                          Background="Transparent" BorderThickness="0" 
                          ItemsSource="{Binding MyBonusDetails}" 
                          SelectedItem="{Binding SelectedBonusModel}" 
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="13cm"/>
                                    <ColumnDefinition Width="4cm"/>
                                    <ColumnDefinition Width="2cm"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="0">
                                    <TextBlock Text="{Binding DetailPoint}"/>
                                </Border>
                                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1">
                                    <TextBlock Text="{Binding Comment}" />
                                </Border>
                                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="2">
                                    <TextBlock Text="{Binding Amount}" DockPanel.Dock="Right" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="13cm"/>
                        <ColumnDefinition Width="4cm"/>
                        <ColumnDefinition Width="2cm"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label FontWeight="Bold" Content="Name: "/>
                        <TextBlock HorizontalAlignment="left" Text="{Binding WorkerName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label FontWeight="Bold" Content="Period: "/>
                        <TextBlock HorizontalAlignment="Center" Text="{Binding Period}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label FontWeight="Bold">TOTAL:</Label>
                        <TextBlock HorizontalAlignment="Center" FontSize="18px" FontWeight="Bold" Text="{Binding Total}"></TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Signature Worker" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="Signature Teamleader/Manager" FontWeight="Bold" Margin="0,10,0,0"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Footer with Buttons -->
        <Border Grid.Row="2" Background="#221738" Padding="20" BorderThickness="0,1,0,0" BorderBrush="#3D2B5C">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="🖨 Print" Style="{StaticResource TransformedButtonBorder}" 
                        Command="{Binding BtnPrintPreview}" 
                        CommandParameter="{Binding ElementName=PrintArea}"
                        Padding="20,12" FontSize="14" FontWeight="SemiBold" Foreground="White"
                        Width="180" Margin="0,0,15,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00B8A9" Offset="0"/>
                            <GradientStop Color="#00D4AA" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Content="✓ Finish" Style="{StaticResource TransformedButtonBorder}" 
                        Command="{Binding BtnBackButton}"
                        Padding="20,12" FontSize="14" FontWeight="SemiBold" Foreground="White"
                        Width="180">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A2D7A" Offset="0"/>
                            <GradientStop Color="#6B3FA0" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
