<UserControl x:Class="MVVM_Bonus.View.PrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000">

    <!-- Reachable only through BonusViewModel.BtnDetailViewCommand, which is not bound
         to anything: printing now happens inline on the bonus history and new-bonus
         screens. Kept and restyled rather than deleted, since removing a screen is a
         decision for the team, not a side effect of a redesign. -->
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppBar}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextPageTitle}" Text="{Binding WorkerName}"/>
                    <TextBlock Style="{StaticResource TextCaption}"
                               Text="{Binding Period, StringFormat='Bonus sheet · period {0}'}"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextCaption}" Text="Total" TextAlignment="Right"/>
                    <TextBlock Style="{StaticResource TextAmount}" FontSize="19"
                               Foreground="{StaticResource BrandAccent}"
                               Text="{Binding Total, StringFormat='{}{0:N2} €'}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The sheet itself stays white: it is what goes to the printer. -->
        <ScrollViewer Grid.Row="1" Margin="20"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid Name="PrintArea" Background="White"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  MaxHeight="27.5cm" MaxWidth="21cm" Margin="20">
                <Grid.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.5"/>
                </Grid.Effect>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,20,24,10">
                    <TextBlock Text="Bauer Media Outdoor" FontFamily="Segoe UI"
                               FontSize="17" FontWeight="Bold" Foreground="Black"/>
                    <TextBlock Text="Prime de qualité / Quality bonus" FontFamily="Segoe UI"
                               FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                </StackPanel>

                <ItemsControl Grid.Row="1" Margin="24,4,24,4"
                              ItemsSource="{Binding MyBonusDetails}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4.2cm"/>
                                    <ColumnDefinition Width="2.2cm"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#BBBBBB" BorderThickness="1,1,0,1" Padding="6,5">
                                    <TextBlock Text="{Binding DetailPoint}" FontFamily="Segoe UI" FontSize="10"
                                               Foreground="Black" TextWrapping="Wrap"/>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#BBBBBB" BorderThickness="1,1,0,1" Padding="6,5">
                                    <TextBlock Text="{Binding Comment}" FontFamily="Segoe UI" FontSize="10"
                                               Foreground="Black" TextWrapping="Wrap"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#BBBBBB" BorderThickness="1" Padding="6,5">
                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} €'}"
                                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                               Foreground="Black" TextAlignment="Right"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2" Margin="24,10,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4.2cm"/>
                        <ColumnDefinition Width="2.2cm"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Name" FontFamily="Segoe UI" FontSize="9" Foreground="#666666"/>
                        <TextBlock Text="{Binding WorkerName}" FontFamily="Segoe UI" FontSize="11"
                                   FontWeight="SemiBold" Foreground="Black"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="Period" FontFamily="Segoe UI" FontSize="9" Foreground="#666666"/>
                        <TextBlock Text="{Binding Period}" FontFamily="Segoe UI" FontSize="11"
                                   FontWeight="SemiBold" Foreground="Black"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Total" FontFamily="Segoe UI" FontSize="9" Foreground="#666666"
                                   TextAlignment="Right"/>
                        <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} €'}" FontFamily="Segoe UI"
                                   FontSize="13" FontWeight="Bold" Foreground="Black" TextAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,30,20,0">
                        <Border BorderBrush="#999999" BorderThickness="0,0,0,1" Height="26"/>
                        <TextBlock Text="Signature employee" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="#666666" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,30,0,0">
                        <Border BorderBrush="#999999" BorderThickness="0,0,0,1" Height="26"/>
                        <TextBlock Text="Signature team leader / manager" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="#666666" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource AppFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Print"
                        Tag="{StaticResource IconPrint}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding BtnPrintPreview}"
                        CommandParameter="{Binding ElementName=PrintArea}"
                        MinHeight="44" MinWidth="170" Margin="0,0,12,0"/>
                <Button Content="Done"
                        Tag="{StaticResource IconCheck}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BtnBackButton}"
                        MinHeight="44" MinWidth="150"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
