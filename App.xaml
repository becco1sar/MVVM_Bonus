<Application x:Class="MVVM_Bonus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MVVM_Bonus"
             xmlns:vm="clr-namespace:MVVM_Bonus.ViewModel"
             xmlns:v="clr-namespace:MVVM_Bonus.View"
             
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GeneralViewModel}">
            <v:GeneralView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GetBonusViewModel}">
            <v:GetBonusView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsertViewModel}">
            <v:InsertView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsertViewVeloViewModel}">
            <v:InsertViewVelo/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintingViewModel}">
            <v:PrintingView/>
        </DataTemplate>
        <Style TargetType="Button" x:Key="TransformedButtonBorder">
            <Setter Property="FontSize" Value="18px"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="white"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderButtonControl"  BorderThickness="1" CornerRadius="5" Background="#F48473" Height="50" Margin="5" Width="Auto">
                            <ContentPresenter x:Name="ButtonPresenter" ContentSource="Content" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderButtonControl" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>

            </Setter>
        </Style>

    </Application.Resources>
</Application>
