<Application x:Class="MVVM_Bonus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MVVM_Bonus"
             xmlns:vm="clr-namespace:MVVM_Bonus.ViewModel"
             xmlns:v="clr-namespace:MVVM_Bonus.View"
             
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <v:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
                <v:GeneralView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BonusViewModel}">
                <v:GetBonusView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HrDashboardViewModel}">
                <v:HrDashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StaffManagementViewModel}">
                <v:StaffManagementView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BonusConfigViewModel}">
                <v:BonusConfigView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InsertViewModel}">
                <v:InsertView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrintingViewModel}">
                <v:PrintingView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
