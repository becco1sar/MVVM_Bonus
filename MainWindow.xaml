<Window x:Class="MVVM_Bonus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MVVM_Bonus"
        mc:Ignorable="d"
        Title="BMO Quality Bonus"
        Height="800" Width="1320"
        MinHeight="620" MinWidth="1080"
        WindowStyle="None"
        Background="{StaticResource BgDarkest}"
        WindowStartupLocation="CenterScreen">

    <!-- WindowChrome keeps the native resize borders, edge snapping, Aero Snap and
         correct maximise behaviour while still letting the title bar be drawn here.
         The previous WindowStyle="None" + AllowsTransparency="True" combination threw
         all of that away: the window could not be resized from its edges, could not
         be snapped, and covered the taskbar when maximised. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Title bar button. Square, unlabelled, and hit-testable through the chrome. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <Path x:Name="Glyph"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  Width="11" Height="11"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <StreamGeometry x:Key="GlyphMinimize">M 0 6 L 12 6</StreamGeometry>
        <StreamGeometry x:Key="GlyphMaximize">M 0.5 0.5 L 11.5 0.5 L 11.5 11.5 L 0.5 11.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphRestore">M 3 0.5 L 11.5 0.5 L 11.5 9 M 0.5 3 L 9 3 L 9 11.5 L 0.5 11.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphClose">M 0.5 0.5 L 11.5 11.5 M 11.5 0.5 L 0.5 11.5</StreamGeometry>
    </Window.Resources>

    <Grid Background="{StaticResource BgDarkest}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar. Dragging and double-click-to-maximise come from WindowChrome's
             caption area, so there is no DragMove handler to keep in step. -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrandAccent}" Margin="0,0,9,0"/>
                    <TextBlock Text="BMO Quality Bonus"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Segoe UI" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}"
                            Tag="{StaticResource GlyphMinimize}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimise"/>

                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            Tag="{StaticResource GlyphMaximize}"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximise"/>

                    <Button Style="{StaticResource CloseCaptionButton}"
                            Tag="{StaticResource GlyphClose}"
                            Click="CloseButton_Click"
                            ToolTip="Close"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}"/>
    </Grid>
</Window>
